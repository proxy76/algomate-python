# /etc/algomate-python.env — read by the systemd unit.

SANDBOX=docker
SANDBOX_IMAGE=algomate-python-sandbox:latest
# Stronger isolation with gVisor (install runsc first, see README):
# SANDBOX_RUNTIME=runsc

# Only browsers on this origin may open the run WebSocket.
ALLOWED_ORIGINS=https://python.algomate.ro

# Set to 1 ONLY if the server is reachable exclusively through Cloudflare
# (e.g. Cloudflare Tunnel). Otherwise clients could spoof their IP.
TRUST_CLOUDFLARE=0

DB_PATH=/var/lib/algomate-python/snippets.db
STATIC_DIR=/opt/algomate-python/frontend/dist

# Per-run limits
RUN_WALL_TIMEOUT=120
RUN_CPU_LIMIT=10
RUN_MEMORY_MB=256
RUN_CPUS=1
RUN_PIDS_LIMIT=64
RUN_MAX_OUTPUT_BYTES=1000000

# Capacity / abuse limits
MAX_CONCURRENT_RUNS=8
MAX_RUNS_PER_IP=2
RUNS_PER_MINUTE=30
SHARES_PER_HOUR=30
